{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Windows portable release",
  "type": "object",
  "required": ["version", "sha256", "authenticode", "size", "platform", "proof"],
  "properties": {
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$"},
    "platform": {"const":"windows-x64"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "size": {"type":"integer","minimum":1,"maximum":33554432},
    "proof": {"type":"string","minLength":128,"maxLength":1024},
    "authenticode": {"type":"object","required":["status","publisher","timestamped"]}
  }
}
