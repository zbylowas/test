{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zamknięcie sesji v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "ended_at",
    "chunk_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "completed",
        "partial",
        "cancelled",
        "failed"
      ]
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    }
  }
}
