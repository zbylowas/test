{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Otwarcie sesji v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "started_at",
    "client_version",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "mode": {
      "enum": [
        "portable",
        "agent"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_version",
        "targets",
        "attempts",
        "max_ttl",
        "timeout_ms",
        "interval_ms",
        "protocol",
        "phase_control"
      ],
      "properties": {
        "windows_version": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$|^unavailable:RtlGetVersion$",
          "maxLength": 64
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "anyOf": [
              {
                "format": "ipv4"
              },
              {
                "format": "ipv6"
              }
            ]
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_ttl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "protocol": {
          "enum": [
            "icmp",
            "tcp",
            "both"
          ]
        },
        "phase_control": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "mtr",
            "gaming",
            "monitor"
          ]
        },
        "target_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "profile_name": {
          "type": "string",
          "maxLength": 96
        },
        "technique": {
          "enum": [
            "echo",
            "trace"
          ]
        },
        "region": {
          "type": "string",
          "maxLength": 60
        },
        "target_kind": {
          "enum": [
            "official_diagnostic",
            "steam_relay",
            "game_server",
            "game_service",
            "network_probe",
            "session_relay",
            "session_server",
            "user_supplied"
          ]
        }
      }
    },
    "inventory": {
      "$ref": "inventory.schema.json"
    },
    "throughput": {
      "$ref": "throughput.schema.json"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "reason"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "method": {
          "enum": [
            "windows_installation_v1",
            "local_profile_v1",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "windows_installation_v1"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "local_profile_v1"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "unavailable"
            },
            "id": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
